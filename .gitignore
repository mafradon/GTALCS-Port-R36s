# ─── User-owned game content — MUST NEVER be committed (Rockstar copyright) ──
# The port redistributes no game data.  The engine, the APK assets and the OBBs
# all come out of the player's own copy at install time.
extracted/
*.apk
*.obb
libGTALcs.so
data/
Original-Files

# ─── Cross-compile sysroots (symlinks into the CTW port's tree) ─────────────
armhf-sysroot
bullseye-sysroot

# ─── Build artifacts ────────────────────────────────────────────────────────
*.o
*.so
*.armhf
gtalcs_r36
*.zip

# release/ is generated by scripts/make-release.sh from gta-lcs-portmaster/.
release/
output/

# make-release.sh copies the freshly built binaries and the OBB name dictionary
# into the package directory on every run.  The package's *sources* are tracked;
# these copies are not.  obb_dictionary.txt lives in scripts/.
gta-lcs-portmaster/gtalcs/*.armhf
gta-lcs-portmaster/gtalcs/*.so
gta-lcs-portmaster/gtalcs/libs.armhf/
gta-lcs-portmaster/gtalcs/obb_dictionary.txt
gta-lcs-portmaster/gtalcs/conf/

# ─── Bring-up debris ────────────────────────────────────────────────────────
*.log
frame*.ppm
docs/logs/
scripts/__pycache__/
__pycache__/

# Raw symbol dump of the player's own libGTALcs.so — derived from game data,
# and 900 KB of noise.  Regenerate with `make check-syms` if you need it.
docs/libGTALcs-dynsyms.txt

# ─── Editors / OS ───────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Device-testing harness — not part of the port ──────────────────────────
# devtest.sh drives a real device over ssh and carries its address and login.
# It is a local development tool; the repo ships only the port and installer.
scripts/devtest.sh
scripts/devtest.env
